# python
__pycache__/
*.pyc
.venv/
venv/
.env

# activations / model cache — large, regenerated
activations_cache/*
!activations_cache/.gitkeep
*.npy
*.npz
*.parquet
hf_cache/

# results artifacts (keep RESULTS.md, ignore heavy figures/pickles if desired)
results/*.pkl
results/*.pt

# latex build artifacts (keep the sources, keep the pdf out of git)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.pdf
paper/*.synctex.gz

# terraform
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/.terraform.lock.hcl
infra/terraform.tfvars

# os
.DS_Store

# figures are build artifacts of scripts/make_figures.py, but committed so the
# paper builds for anyone without re-running the pipeline
!paper/figures/*.pdf
